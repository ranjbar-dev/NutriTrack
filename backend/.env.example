# Server
PORT=8080
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://nutritrack:nutritrack@localhost:5432/nutritrack?sslmode=disable

# JWT
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Kavenegar SMS Gateway
SMS_API_KEY=your-kavenegar-api-key
SMS_TEMPLATE=your-kavenegar-verify-template

# Super Admin Seed (used by cmd/seed)
ADMIN_EMAIL=admin@nutritrack.ir
ADMIN_PASSWORD=change-me-strong-password
