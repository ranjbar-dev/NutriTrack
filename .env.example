# ──────────────────────────────────────────
# NutriTrack Environment Configuration
# Copy to .env and fill in values
# ──────────────────────────────────────────

# ── Domain & URLs ──
DOMAIN=nutritrack.example.com
FRONTEND_URL=https://nutritrack.example.com
ACME_EMAIL=admin@example.com

# ── Database ──
POSTGRES_DB=nutritrack
POSTGRES_USER=nutritrack
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgres://nutritrack:CHANGE_ME_strong_password_here@postgres:5432/nutritrack?sslmode=disable

# ── Auth ──
JWT_SECRET=CHANGE_ME_minimum_32_characters_random_string
# Generate with: openssl rand -base64 32

# ── SMS (Kavenegar) ──
KAVENEGAR_API_KEY=your_kavenegar_api_key
KAVENEGAR_TEMPLATE=nutritrack-otp
SMS_PROVIDER=mock
# Set to "kavenegar" in production

# ── Application ──
ENVIRONMENT=development
PORT=8080
GIN_MODE=debug
# Set GIN_MODE=release in production

# ── Super Admin Seeder ──
ADMIN_EMAIL=admin@nutritrack.com
ADMIN_PASSWORD=CHANGE_ME_admin_password

# ── File Uploads ──
UPLOADS_DIR=/data/uploads
