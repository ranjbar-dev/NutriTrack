DOMAIN=nutritrack.example.com
GRAFANA_DOMAIN=grafana.nutritrack.example.com
FRONTEND_URL=https://nutritrack.example.com
ACME_EMAIL=admin@example.com

POSTGRES_DB=nutritrack
POSTGRES_USER=nutritrack
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here
DATABASE_URL=postgres://nutritrack:CHANGE_ME_strong_password_here@postgres:5432/nutritrack?sslmode=disable

JWT_SECRET=CHANGE_ME_minimum_32_characters_random_string
ADMIN_EMAIL=admin@nutritrack.com
ADMIN_PASSWORD=CHANGE_ME_admin_password

ENVIRONMENT=production
GIN_MODE=release
PORT=8080
UPLOADS_DIR=/data/uploads

SMS_API_KEY=your_kavenegar_api_key
SMS_TEMPLATE=nutritrack-otp
NUXT_PUBLIC_API_BASE=https://nutritrack.example.com/api
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nutritrack.example.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana_password
POSTGRES_BACKUP_INTERVAL_SECONDS=86400
UPLOADS_BACKUP_INTERVAL_SECONDS=604800
