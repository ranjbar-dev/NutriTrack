# ================================================
# NutriTrack — متغیرهای محیطی
# لطفاً این فایل را به .env کپی کنید و مقادیر را تنظیم نمایید
# ================================================

# ── برنامه / Application ─────────────────────────────────────
PORT=8080                                   # پورت HTTP سرویس
ENV=development                             # محیط اجرا: development | production
TIMEZONE=Asia/Tehran                        # منطقه زمانی (تهران)

# ── پایگاه داده / Database ───────────────────────────────────
DB_HOST=postgres                            # هاست PostgreSQL (نام سرویس docker-compose)
DB_PORT=5432                                # پورت PostgreSQL
DB_USER=nutritrack                          # نام کاربری دیتابیس
DB_PASSWORD=nutritrack_secret               # رمز عبور دیتابیس — در پروداکشن تغییر دهید
DB_NAME=nutritrack                          # نام دیتابیس
DB_SSLMODE=disable                          # حالت SSL: disable | require | verify-full

# DSN کامل برای ابزار migrate CLI (golang-migrate)
DATABASE_URL=postgres://nutritrack:nutritrack_secret@localhost:5432/nutritrack?sslmode=disable

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis                            # هاست Redis (نام سرویس docker-compose)
REDIS_PORT=6379                             # پورت Redis
REDIS_PASSWORD=                             # رمز عبور Redis (خالی = بدون رمز)
REDIS_DB=0                                  # شماره دیتابیس Redis (۰ تا ۱۵)

# ── JWT / احراز هویت ─────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_32chars_min   # کلید امضای Access Token — حداقل ۳۲ کاراکتر
JWT_REFRESH_SECRET=change_me_refresh_secret_32chars_min # کلید امضای Refresh Token — حداقل ۳۲ کاراکتر
JWT_ACCESS_TTL_MIN=15                       # مدت اعتبار Access Token (دقیقه)
JWT_REFRESH_TTL_DAY=7                       # مدت اعتبار Refresh Token (روز)

# ── SMS / کاوه‌نگار ───────────────────────────────────────────
KAVENEGAR_API_KEY=your_kavenegar_api_key    # API Key پنل کاوه‌نگار
KAVENEGAR_OTP_TEMPLATE=verify               # نام قالب پیامک OTP در کاوه‌نگار

# ── VAPID / اعلان‌های Push ────────────────────────────────────
# برای تولید کلیدها: go run github.com/SherClockHolmes/webpush-go/cmd/vapid-keygen
VAPID_PUBLIC_KEY=                           # کلید عمومی VAPID برای Web Push
VAPID_PRIVATE_KEY=                          # کلید خصوصی VAPID برای Web Push

# ── CORS ────────────────────────────────────────────────────
# آدرس‌های مجاز برای CORS — با کاما جدا شوند؛ * = همه آدرس‌ها (پیش‌فرض)
CORS_ALLOWED_ORIGINS=*                      # مثال: https://app.nutritrack.ir,https://admin.nutritrack.ir
